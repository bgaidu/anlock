<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 通知运行时权限：不授予则前台服务的倒计时通知不可见 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 跨重启对账用：家长在 设置→特殊访问权限→有权查看使用情况 授予后才生效 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- 守护服务自助开关用：需 adb 授权一次（pm grant），此后应用可自行恢复无障碍启用状态 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Android 12+ 精确到期闹钟：targetSdk 33 默认拒绝，需 adb 授权（appops set ... allow）。
         旧系统（含电视 Android 6）忽略此未知权限，精确闹钟本就可用，不受影响 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 11+ 包可见性：应用限额需要列出桌面应用供家长选择 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <!-- 应用内「权限检查」页可直接弹出电池优化豁免确认框 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 局域网家长面板（同一 Wi-Fi 下的手机/电脑浏览器访问） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".KidsLockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsLock"
        android:usesCleartextTraffic="false"
        android:resizeableActivity="false">

        <!-- Settings / Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/tv_banner"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- 同时声明 LAUNCHER + LEANBACK_LAUNCHER，兼容手机和 Android TV / 小米电视桌面 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lock Screen Activity -->
        <activity
            android:name=".LockScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.KidsLock.FullScreen" />

        <!-- Question Preview Activity (R24：预览一道题，PIN 门禁之后，不导出) -->
        <activity
            android:name=".QuestionPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.KidsLock" />

        <!-- 权限检查（家长在设置页内逐项开启系统权限） -->
        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.KidsLock" />

        <!-- HOME launcher alias (disabled by default, enabled when locked) -->
        <activity-alias
            android:name=".LockScreenHome"
            android:targetActivity=".LockScreenActivity"
            android:enabled="false"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.KidsLock.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Boot Receiver -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.android.intent.action.BOOT_COMPLETED" />
                <!-- 小米/MIUI 电视用自定义广播代替被拦截的 BOOT_COMPLETED -->
                <action android:name="android.intent.action.autoStart" />
            </intent-filter>
        </receiver>

        <!-- 计时到期闹钟：进程被系统杀死后，靠 AlarmManager 在到点时刻唤醒并恢复守护 -->
        <receiver
            android:name=".AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 复活闹钟：计时中/锁屏中每 15 分钟唤醒一次服务（不精确闹钟，无需额外权限） -->
        <receiver
            android:name=".ReviveReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 复活作业：系统持久化定时任务，开机后由系统重新排程，作为开机广播被拦截时的兜底 -->
        <service
            android:name=".WatchdogJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 守护无障碍服务：系统开机自动绑定已启用的无障碍服务（不受自启动拦截），
             进程被杀也会被系统重新绑定——免 ROOT 设备上的开机自启与复活通道 -->
        <service
            android:name=".RecoveryAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/recovery_accessibility_config" />
        </service>

        <!-- 设备管理器：adb 设为 Device Owner 后启用 LockTask（kiosk）与防卸载 -->
        <receiver
            android:name=".KidsDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Device Owner 被系统绑定的服务：force-stop 后的复活通道之一 -->
        <service
            android:name=".KidsDeviceAdminService"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <!-- Timer Service -->
        <service
            android:name=".LockService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Children's screen time management timer" />
        </service>

    </application>

</manifest>
