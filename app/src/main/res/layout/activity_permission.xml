<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tv_margin_h">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_title"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="@dimen/spacing_large" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvOverlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:minWidth="140dp"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:minWidth="140dp"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvAlarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnAlarm"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:minWidth="140dp"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvUsage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnUsage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:minWidth="140dp"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvAccessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:minWidth="140dp"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_large">

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:minWidth="140dp"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSecure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_secure_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="@dimen/spacing_small" />

        <Button
            android:id="@+id/btnCopySecure"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:minWidth="240dp"
            android:textAllCaps="false"
            android:text="@string/perm_copy_cmd"
            android:textSize="@dimen/text_body"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="@dimen/spacing_large" />

        <Button
            android:id="@+id/btnPermissionBack"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:minWidth="240dp"
            android:text="@string/perm_back"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>
</ScrollView>
