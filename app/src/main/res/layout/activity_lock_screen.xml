<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:paddingBottom="120dp">

        <LinearLayout
            android:id="@+id/layoutMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/tv_margin_h"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_locked"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <TextView
                android:id="@+id/tvCharacter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_hanzi"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <TextView
                android:id="@+id/tvQuestionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/what_pronounce"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_subtitle"
                android:layout_marginBottom="@dimen/spacing_large" />

            <LinearLayout
                android:id="@+id/layoutOptions1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginLeft="@dimen/tv_margin_h"
                android:layout_marginRight="@dimen/tv_margin_h">

                <Button
                    android:id="@+id/btnOption1"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/btn_margin"
                    android:background="@drawable/btn_option_bg"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/text_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/btnOption3"
                    android:nextFocusRight="@id/btnOption2"
                    android:nextFocusUp="@id/btnOption1"
                    android:nextFocusDown="@id/btnOption3" />

                <Button
                    android:id="@+id/btnOption2"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/btn_margin"
                    android:background="@drawable/btn_option_bg"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/text_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/btnOption1"
                    android:nextFocusRight="@id/btnOption4"
                    android:nextFocusUp="@id/btnOption2"
                    android:nextFocusDown="@id/btnOption4" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutOptions2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginLeft="@dimen/tv_margin_h"
                android:layout_marginRight="@dimen/tv_margin_h">

                <Button
                    android:id="@+id/btnOption3"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/btn_margin"
                    android:background="@drawable/btn_option_bg"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/text_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/btnOption4"
                    android:nextFocusRight="@id/btnOption1"
                    android:nextFocusUp="@id/btnOption1" />

                <Button
                    android:id="@+id/btnOption4"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/btn_margin"
                    android:background="@drawable/btn_option_bg"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/text_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/btnOption3"
                    android:nextFocusRight="@id/btnOption2"
                    android:nextFocusUp="@id/btnOption2" />

            </LinearLayout>

            <!-- 填空题：自己输入答案（数字键盘，遥控器可用） -->
            <LinearLayout
                android:id="@+id/layoutFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvFillInput"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_height"
                    android:minWidth="280dp"
                    android:gravity="center"
                    android:background="@drawable/btn_option_bg"
                    android:text="—"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold"
                    android:paddingStart="@dimen/spacing_large"
                    android:paddingEnd="@dimen/spacing_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fill_input_tip"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_height"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button android:id="@+id/btnKey7" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="7"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusRight="@id/btnKey8" android:nextFocusDown="@id/btnKey4" />
                    <Button android:id="@+id/btnKey8" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="8"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey7" android:nextFocusRight="@id/btnKey9"
                        android:nextFocusDown="@id/btnKey5" />
                    <Button android:id="@+id/btnKey9" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="9"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey8" android:nextFocusRight="@id/btnKeyBack"
                        android:nextFocusDown="@id/btnKey6" />
                    <Button android:id="@+id/btnKeyBack" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="⌫"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey9" android:nextFocusDown="@id/btnKeySlash" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_height"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button android:id="@+id/btnKey4" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="4"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusRight="@id/btnKey5" android:nextFocusUp="@id/btnKey7"
                        android:nextFocusDown="@id/btnKey1" />
                    <Button android:id="@+id/btnKey5" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="5"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey4" android:nextFocusRight="@id/btnKey6"
                        android:nextFocusUp="@id/btnKey8" android:nextFocusDown="@id/btnKey2" />
                    <Button android:id="@+id/btnKey6" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="6"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey5" android:nextFocusRight="@id/btnKeyDot"
                        android:nextFocusUp="@id/btnKey9" android:nextFocusDown="@id/btnKey3" />
                    <Button android:id="@+id/btnKeyDot" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="."
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey6" android:nextFocusUp="@id/btnKeyBack"
                        android:nextFocusDown="@id/btnKeySlash" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_height"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button android:id="@+id/btnKey1" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="1"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusRight="@id/btnKey2" android:nextFocusUp="@id/btnKey4"
                        android:nextFocusDown="@id/btnKey0" />
                    <Button android:id="@+id/btnKey2" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="2"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey1" android:nextFocusRight="@id/btnKey3"
                        android:nextFocusUp="@id/btnKey5" android:nextFocusDown="@id/btnKey0" />
                    <Button android:id="@+id/btnKey3" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="3"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey2" android:nextFocusRight="@id/btnKeySlash"
                        android:nextFocusUp="@id/btnKey6" android:nextFocusDown="@id/btnKeyOk" />
                    <Button android:id="@+id/btnKeySlash" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_key_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="/"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey3" android:nextFocusUp="@id/btnKeyDot"
                        android:nextFocusDown="@id/btnKeyOk" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_height"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button android:id="@+id/btnKey0" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="@dimen/btn_key_width" android:layout_height="match_parent"
                        android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_option_bg" android:text="0"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusRight="@id/btnKeyOk" android:nextFocusUp="@id/btnKey1" />
                    <Button android:id="@+id/btnKeyOk" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:minWidth="@dimen/btn_ok_width" android:layout_margin="@dimen/btn_margin"
                        android:background="@drawable/btn_settings_bg" android:text="@string/fill_confirm"
                        android:textColor="@color/btn_text" android:textSize="@dimen/text_button"
                        android:focusable="true" android:clickable="true"
                        android:nextFocusLeft="@id/btnKey0" android:nextFocusUp="@id/btnKey3" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/correct_green"
                android:textSize="@dimen/text_body"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- 底部固定区：今日额度 + 答题进度提示 + 8 空格间隔 + 家长解锁（字号缩小一半） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvQuota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_tiny"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gap_spaces"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btnParentUnlock"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parent_unlock"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_tiny"
                android:background="@drawable/btn_settings_bg"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnOption3"
                android:nextFocusDown="@id/btnOption1" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/layoutPin"
        layout="@layout/view_pin_pad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
