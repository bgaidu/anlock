<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 家长 PIN 门禁：默认盖在设置页上，验证通过后才显示设置 -->
    <include
        android:id="@+id/layoutGate"
        layout="@layout/view_pin_pad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tv_margin_h"
        android:gravity="center_horizontal">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- 版本号：确认电视端装的是哪个版本 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- ===== 计时控制 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_timer"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button
                android:id="@+id/btnStartTimer"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="@dimen/btn_min_width"
                android:text="@string/btn_start_timer"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnStopTimer"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="@dimen/btn_min_width"
                android:text="@string/btn_stop_timer"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnLockNow"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="@dimen/btn_min_width"
                android:text="@string/btn_lock_now"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- ===== 参数配置 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_config"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- 开机自启 -->
        <Button
            android:id="@+id/btnAutoStart"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 紧急重启解锁（默认关闭；开启后 3 分钟内重启 3 次即解锁，孩子可借此绕过） -->
        <Button
            android:id="@+id/btnEmergencyReboot"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 屏幕角标：计时中在右上角显示剩余时间（需要悬浮窗权限） -->
        <Button
            android:id="@+id/btnShowCountdown"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 观看时长 -->
        <TextView
            android:id="@+id/tvWatchTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- 今日已用时长（每日总时长上限的实时进度） -->
        <TextView
            android:id="@+id/tvDailyUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- 每日总时长上限：点击选择 关闭 / 60 / 90 / 120 / 180 分钟 -->
        <Button
            android:id="@+id/btnDailyLimit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 近 7 天使用记录：按天展示屏幕使用时长（每日上限的历史） -->
        <Button
            android:id="@+id/btnUsageHistory"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_usage_history"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 周报：7 天柱状图 + 答题/星星/错题汇总 -->
        <Button
            android:id="@+id/btnWeeklyReport"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_weekly_report"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 局域网家长面板：同一 Wi-Fi 下用手机浏览器管控 -->
        <Button
            android:id="@+id/btnLanPanel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_lan_panel"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 使用时段：只在允许的时间段内可用（家长 PIN 可临时放行） -->
        <TextView
            android:id="@+id/tvSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <Button
            android:id="@+id/btnSchedule"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_small"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 星星兑换：家长自定义「多少颗星换多少分钟」，兑换后下次解锁生效 -->
        <Button
            android:id="@+id/btnStarExchange"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnTime15"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="15分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime30"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="30分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime45"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="45分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime60"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="60分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime90"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="90分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime120"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="120分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- 解锁题数 -->
        <TextView
            android:id="@+id/tvUnlockCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnUnlock5"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="5题"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnUnlock10"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="10题"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnUnlock15"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:minWidth="80dp"
                android:text="15题"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- ===== 出题设置（年级 / 科目） ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_question"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvQuestionGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnGrade0"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnGrade6" />
            <Button android:id="@+id/btnGrade1"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnGrade2"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnGrade3"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnGrade4"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnGrade5"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnGrade6"
                android:layout_width="@dimen/btn_grade_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/btnGrade0" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuestionSubjects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnSubjectPinyin"
                android:layout_width="@dimen/btn_subject_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:text="@string/btn_subject_pinyin"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnSubjectCitu"
                android:nextFocusRight="@id/btnSubjectMath" />
            <Button android:id="@+id/btnSubjectMath"
                android:layout_width="@dimen/btn_subject_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:text="@string/btn_subject_math"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnSubjectPinyin"
                android:nextFocusRight="@id/btnSubjectEnglish" />
            <Button android:id="@+id/btnSubjectEnglish"
                android:layout_width="@dimen/btn_subject_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:text="@string/btn_subject_english"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnSubjectMath"
                android:nextFocusRight="@id/btnSubjectCitu" />
            <Button android:id="@+id/btnSubjectCitu"
                android:layout_width="@dimen/btn_subject_width"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:singleLine="true"
                android:textAllCaps="false"
                android:text="@string/btn_subject_citu"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnSubjectEnglish"
                android:nextFocusRight="@id/btnSubjectPinyin" />
        </LinearLayout>

        <!-- 题型与复习：判断题、错题加练开关 -->
        <Button
            android:id="@+id/btnQuestionTypes"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_question_types"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/tvSubjectWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wrong_red"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:visibility="gone" />

        <!-- 预览一道题（R24：PIN 门禁之后，复用引擎+锁屏渲染，不计入防重复队列） -->
        <Button
            android:id="@+id/btnPreviewQuestion"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_preview_question"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 答题正确率（R25：累计口径，total==0 时隐藏） -->
        <TextView
            android:id="@+id/tvAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnResetStats"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_reset_stats"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- PIN 状态（T5：显示是否已修改默认 PIN） -->
        <TextView
            android:id="@+id/tvPinStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone" />

        <!-- 自定义题库（家长导入，R26） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_custom_bank"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/custom_bank_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_small"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnImportBank"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_import_bank"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <Button
            android:id="@+id/btnExportBank"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_export_bank"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <Button
            android:id="@+id/btnClearBank"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_clear_bank"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 题库管理：按科目/年级查看条数、来源与预览，就地导入/导出/清除 -->
        <Button
            android:id="@+id/btnBankManager"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_bank_manager"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 权限检查（应用内逐项开启系统权限） -->
        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 管控体检：逐项显示拦截能力，点未就绪项直接去开 -->
        <Button
            android:id="@+id/btnHealth"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:minWidth="300dp"
            android:text="@string/btn_health"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 诊断日志：家长可查看最近 300 行关键事件（锁屏/解锁/权限变化/复活） -->
        <Button
            android:id="@+id/btnDiag"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="查看诊断日志"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 守护服务（无障碍）状态：未开启时点击跳转系统无障碍设置 -->
        <Button
            android:id="@+id/btnGuardStatus"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 设置PIN -->
        <Button
            android:id="@+id/btnSetPin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_set_pin"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 说明文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="默认PIN码：1234"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/spacing_large" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_bottom"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_small"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
</FrameLayout>
